{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/calendar",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/placements",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/tasks?run=morning",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/tasks?run=evening",
      "schedule": "0 13 * * *"
    }
  ]
}
